</header>

<main class="vault" id="main">

  <!-- HERO — rides up over the header bar -->
  <div class="hero" id="hero">
    <h1 id="hero-title">Built to last</h1>
    <p id="hero-sub">Converts PDFs to PDF/A, the archival format for permanent City records. Every record is checked against the standard after conversion.</p>
  </div>

  <!-- S1 · ACCESSION -->
  <section id="upload-section" class="stack" aria-label="Add records">

    <div
      id="drop-zone"
      class="drop-zone"
      role="button"
      tabindex="0"
      aria-label="Add PDF or ZIP files: drop them here or press Enter to browse"
    >
      <svg width="56" height="42" viewBox="0 0 56 42" shape-rendering="crispEdges" aria-hidden="true">
        <rect x="8" y="10" width="40" height="28" fill="#CFC6AE" stroke="#1A2422" stroke-width="2"/>
        <g class="box-lid">
          <rect x="4" y="4" width="48" height="8" fill="#B0814A" stroke="#1A2422" stroke-width="2"/>
        </g>
        <rect x="22" y="18" width="12" height="6" fill="#FFFFFF" stroke="#1A2422" stroke-width="2"/>
      </svg>
      <div class="drop-zone-title">PLACE RECORDS IN THE BOX</div>
      <div class="drop-zone-sub">or click to browse · .pdf and .zip only</div>
      <input type="file" id="file-input" accept=".pdf,.zip" multiple class="d-none" aria-hidden="true" tabindex="-1">
    </div>

    <div id="file-warnings" class="notice d-none" role="alert"></div>

    <div id="file-list-section" class="list-card d-none">
      <div class="list-head">
        <span class="label">Accession list</span>
        <span class="label" id="file-list-count"></span>
      </div>
      <ul id="file-list" class="file-list"></ul>
    </div>

    <div class="force-opt">
      <label class="force-label">
        <input type="checkbox" id="force-image" aria-describedby="force-explain">
        <span>Force archival for difficult files</span>
      </label>
      <div id="force-explain" class="force-explain d-none">
        Some PDFs contain things the archival format doesn't allow, so they can't be
        preserved as they are. With this on, <strong>only those files</strong> are rebuilt
        as a picture of each page with searchable text laid on top. They will pass as PDF/A, but:
        the file gets bigger, the text is re-read by OCR and can contain mistakes, and links,
        bookmarks and form fields stop working. Files that convert normally are not changed.
      </div>
    </div>

    <div class="actions">
      <div class="actions-hint">ZIPs are opened and each PDF inside is preserved separately.</div>
      <button id="convert-btn" type="button" class="press-btn" disabled>Preserve records</button>
    </div>

  </section>

  <!-- S2 · PRESERVING -->
  <section id="progress-section" class="d-none" aria-label="Preserving">
    <div class="shelf-wrap">
      <div class="shelf-meta">
        <span class="label">Shelf</span>
        <span class="shelf-count" id="shelf-count"></span>
      </div>
      <div id="shelf" class="shelf" aria-hidden="true"></div>
      <div id="progress-bar" class="sr-only" role="progressbar" aria-label="Conversion progress"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
      <div id="progress-label" class="now-preserving">Uploading…</div>
    </div>

    <div class="list-card" style="margin-top: 18px;">
      <ul id="status-list" class="status-list"></ul>
    </div>
  </section>

  <!-- S3 / S4 · IN THE VAULT, or a dead end -->
  <section id="complete-section" class="d-none" aria-label="Results">

    <div id="error-summary" class="sr-only" role="status"></div>

    <div id="download-area" class="vault-card d-none">
      <div>
        <h2 class="section-title" id="complete-title"></h2>
        <p class="section-sub">Your converted files are ready. They are deleted from the server when the vault closes.</p>
      </div>

      <div class="vault-box">
        <div class="vault-main">
          <div id="tallies" class="tallies"></div>
          <div class="download-row">
            <a id="download-btn" href="#" class="press-btn press-btn--sm">Download records</a>
            <span id="download-meta" class="download-meta"></span>
          </div>
        </div>
        <div id="vault-panel" class="vault-panel">
          <svg width="44" height="44" viewBox="0 0 20 20" shape-rendering="crispEdges" aria-hidden="true">
            <rect x="2" y="2" width="16" height="16" fill="#2E4A45" stroke="#C9985E" stroke-width="1.5"/>
            <rect x="7" y="7" width="6" height="6" fill="none" stroke="#C9985E" stroke-width="1.5"/>
            <rect x="9.25" y="4" width="1.5" height="3" fill="#C9985E"/>
            <rect x="9.25" y="13" width="1.5" height="3" fill="#C9985E"/>
          </svg>
          <span class="label">Vault closes in</span>
          <span id="expiry-countdown" class="vault-timer" role="timer" aria-label="Time until the vault closes"></span>
        </div>
      </div>

      <div id="attention-section" class="list-card d-none">
        <div class="list-head list-head--paper">
          <span class="label">Needs attention</span>
        </div>
        <ul id="attention-list" class="file-list"></ul>
      </div>

      <div id="expiry-expired" class="sr-only" role="status"></div>

      <div>
        <button id="convert-another-btn" type="button" class="plain-btn">Preserve another batch</button>
      </div>
    </div>

    <div id="dead-end" class="dead-end d-none" role="alert"></div>

  </section>

</main>

<script>
/* Base path — set by Rack SCRIPT_NAME so the app works at any mount point */
const BASE_PATH = "<%= request.script_name %>";

/* =========================================================================
   State
   ========================================================================= */
let selectedFiles  = [];
let currentJobId   = null;
let pollInterval   = null;
let countdownTimer = null;
let vaultDeadline  = null;   // client-clock ms, derived from server expires_at - server_time
let jobCompleted   = false;

/* =========================================================================
   Elements
   ========================================================================= */
const heroEl          = document.getElementById("hero");
const heroTitle       = document.getElementById("hero-title");
const heroSub         = document.getElementById("hero-sub");
const dropZone        = document.getElementById("drop-zone");
const fileInput       = document.getElementById("file-input");
const fileListSection = document.getElementById("file-list-section");
const fileListEl      = document.getElementById("file-list");
const fileListCount   = document.getElementById("file-list-count");
const fileWarnings    = document.getElementById("file-warnings");
const convertBtn      = document.getElementById("convert-btn");
const forceImage      = document.getElementById("force-image");
const forceExplain    = document.getElementById("force-explain");
const uploadSection   = document.getElementById("upload-section");
const progressSection = document.getElementById("progress-section");
const progressBar     = document.getElementById("progress-bar");
const progressLabel   = document.getElementById("progress-label");
const shelfEl         = document.getElementById("shelf");
const shelfCount      = document.getElementById("shelf-count");
const statusList      = document.getElementById("status-list");
const completeSection = document.getElementById("complete-section");
const errorSummary    = document.getElementById("error-summary");
const downloadArea    = document.getElementById("download-area");
const completeTitle   = document.getElementById("complete-title");
const talliesEl       = document.getElementById("tallies");
const downloadBtn     = document.getElementById("download-btn");
const downloadMeta    = document.getElementById("download-meta");
const expiryCountdown = document.getElementById("expiry-countdown");
const expiryExpired   = document.getElementById("expiry-expired");
const attentionSection = document.getElementById("attention-section");
const attentionList   = document.getElementById("attention-list");
const deadEnd         = document.getElementById("dead-end");
const convertAnotherBtn = document.getElementById("convert-another-btn");

const show = (el) => el.classList.remove("d-none");
const hide = (el) => el.classList.add("d-none");

const HERO = {
  idle:       ["Built to last", "Converts PDFs to PDF/A, the archival format for permanent City records. Every record is checked against the standard after conversion."],
  preserving: ["Preserving", "Converting and checking each record. You can leave this tab open in the background."],
};

function setHero(state) {
  if (!HERO[state]) { hide(heroEl); return; }
  heroTitle.textContent = HERO[state][0];
  heroSub.textContent   = HERO[state][1];
  show(heroEl);
}

/* =========================================================================
   Drag & Drop / File Input
   ========================================================================= */
dropZone.addEventListener("click", () => fileInput.click());
dropZone.addEventListener("keydown", (e) => {
  if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fileInput.click(); }
});

dropZone.addEventListener("dragover", (e) => {
  e.preventDefault();
  dropZone.classList.add("drop-zone--active");
});
dropZone.addEventListener("dragleave", () => dropZone.classList.remove("drop-zone--active"));
dropZone.addEventListener("drop", (e) => {
  e.preventDefault();
  dropZone.classList.remove("drop-zone--active");
  handleFiles(Array.from(e.dataTransfer.files));
});

fileInput.addEventListener("change", () => {
  handleFiles(Array.from(fileInput.files));
  fileInput.value = "";
});

function handleFiles(files) {
  const valid   = [];
  const invalid = [];

  files.forEach((f) => {
    const ext = f.name.split(".").pop().toLowerCase();
    if (ext === "pdf" || ext === "zip") {
      valid.push(f);
    } else {
      invalid.push(f.name);
    }
  });

  // Merge (avoid duplicates by name)
  valid.forEach((f) => {
    if (!selectedFiles.find((sf) => sf.name === f.name && sf.size === f.size)) {
      selectedFiles.push(f);
    }
  });

  if (invalid.length > 0) {
    const verb = invalid.length === 1 ? "was" : "were";
    fileWarnings.innerHTML =
      `<div class="label">Not accepted</div>` +
      `<div class="notice-body">${escHtml(invalid.join(", "))} ${verb} left out. Only .pdf and .zip can be preserved.</div>`;
    show(fileWarnings);
  } else {
    hide(fileWarnings);
  }

  renderFileList();
}

function renderFileList() {
  fileListEl.innerHTML = "";
  if (selectedFiles.length === 0) {
    hide(fileListSection);
    convertBtn.disabled = true;
    return;
  }
  show(fileListSection);
  convertBtn.disabled = false;

  const totalBytes = selectedFiles.reduce((sum, f) => sum + f.size, 0);
  const n = selectedFiles.length;
  fileListCount.textContent = `${n} item${n === 1 ? "" : "s"} · ${formatBytes(totalBytes)}`;

  selectedFiles.forEach((f, idx) => {
    const isZip = f.name.toLowerCase().endsWith(".zip");
    const li = document.createElement("li");
    li.className = "row";
    li.innerHTML =
      `<span class="type-chip${isZip ? " type-chip--zip" : ""}">${isZip ? "ZIP" : "PDF"}</span>` +
      `<span class="row-name">${escHtml(f.name)}</span>` +
      `<span class="row-size">${formatBytes(f.size)}</span>` +
      `<button type="button" class="remove-btn" data-idx="${idx}" aria-label="Remove ${escHtml(f.name)}">Remove</button>`;
    fileListEl.appendChild(li);
  });

  fileListEl.querySelectorAll(".remove-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const i = parseInt(e.currentTarget.dataset.idx, 10);
      selectedFiles.splice(i, 1);
      renderFileList();
    });
  });
}

/* =========================================================================
   Upload & Convert
   ========================================================================= */
convertBtn.addEventListener("click", startConversion);

// Explain what "force" does as soon as it's switched on
forceImage.addEventListener("change", () => {
  forceExplain.classList.toggle("d-none", !forceImage.checked);
});

async function startConversion() {
  if (selectedFiles.length === 0) return;

  convertBtn.disabled = true;

  const formData = new FormData();
  selectedFiles.forEach((f) => formData.append("files[]", f, f.name));
  if (forceImage.checked) formData.append("force_image", "1");

  // One thing on screen at a time
  hide(uploadSection);
  hide(completeSection);
  hide(deadEnd);
  setHero("preserving");
  show(progressSection);
  shelfEl.innerHTML = "";
  shelfCount.textContent = "";
  progressBar.setAttribute("aria-valuenow", "0");
  progressLabel.textContent = "Uploading…";
  statusList.innerHTML = "";

  let res, data;
  try {
    res = await fetch(`${BASE_PATH}/upload`, { method: "POST", body: formData });
  } catch (err) {
    showFatalError("Network error: " + err.message);
    return;
  }
  try { data = await res.json(); } catch { data = {}; }
  if (!res.ok || !data.job_id) {
    showFatalError(data.error || `Upload failed (HTTP ${res.status}).`);
    return;
  }

  currentJobId = data.job_id;
  jobCompleted = false;
  startPolling(currentJobId);
}

/* =========================================================================
   Polling
   ========================================================================= */
function startPolling(jobId) {
  pollInterval = setInterval(() => pollStatus(jobId), 2000);
  pollStatus(jobId); // immediate first call
}

async function pollStatus(jobId) {
  let res, data;
  try {
    res = await fetch(`${BASE_PATH}/status/${jobId}`, { cache: "no-store" });
  } catch { return; }            // transient network blip — try again next tick
  if (res.status >= 500) return; // server hiccup — keep polling
  if (!res.ok) {
    stopPolling();
    if (jobCompleted) showVaultClosed();
    else showFatalError(`The job could not be found (HTTP ${res.status}).`);
    return;
  }
  try { data = await res.json(); } catch { return; }
  if (jobId !== currentJobId) return;   // stale response after "Preserve another batch"

  if (data.vault_closed) { stopPolling(); showVaultClosed(); return; }

  updateProgressUI(data);

  if (data.status === "complete" || data.status === "failed") {
    stopPolling();
    showCompletion(data);
  }
}

function stopPolling() {
  if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
}

/* =========================================================================
   Record classification
   ========================================================================= */
// pass: archival grade · warn: converted but check failed / not run ·
// fail: failed or rejected · active: processing · queued
function classify(f) {
  switch (f.status) {
    case "done":
      if (f.skipped) return "pass";
      return f.pdfa_validation && f.pdfa_validation.result === "pass" ? "pass" : "warn";
    case "failed":
    case "rejected":   return "fail";
    case "processing": return "active";
    default:           return "queued";
  }
}

function recordBadge(f) {
  const kind = classify(f);
  if (kind === "pass") {
    const profile = f.pdfa_validation && f.pdfa_validation.profile
      ? "PDF/A-" + String(f.pdfa_validation.profile).toUpperCase()
      : "PDF/A";
    const how = f.forced_image ? " · as images" : "";
    return `<span class="stamp stamp--pass">Archival · ${escHtml(profile)}${how}</span>`;
  }
  if (kind === "warn") {
    return f.pdfa_validation
      ? `<span class="stamp stamp--warn">Converted · check failed</span>`
      : `<span class="stamp stamp--warn">Converted · not checked</span>`;
  }
  if (kind === "fail") {
    return `<span class="stamp stamp--reject">${f.status === "rejected" ? "Rejected" : "Failed"}</span>`;
  }
  if (kind === "active") return `<span class="state-label">PRESERVING</span>`;
  return `<span class="state-label">QUEUED</span>`;
}

// Plain-language error text; falls back to the raw server string.
function plainError(f) {
  const raw = f.error || "";
  if (f.exit_code === 8 || /encrypt|password/i.test(raw)) {
    return "Password-protected — remove the password and try again.";
  }
  if (/unsupported file type/i.test(raw)) return "Only .pdf and .zip can be preserved";
  if (/zip extraction failed/i.test(raw)) return "ZIP could not be opened";
  if (f.exit_code === 2 || /damaged|parse|corrupt|not a valid pdf|magic bytes/i.test(raw)) {
    return "File is damaged and could not be read";
  }
  if (f.exit_code === 10 || /conversion to PDF\/A did not succeed/i.test(raw)) {
    return f.forced_image
      ? "Could not be made archival (PDF/A), even as page images"
      : "Could not be made archival (PDF/A) — turn on “Force archival for difficult files” and try again";
  }
  return shortRaw(raw) || "Could not be converted";
}

// The raw error is the tail of OCRmyPDF's output; show only its last line, capped.
function shortRaw(raw) {
  const lines = String(raw).split("\n").map((l) => l.trim()).filter(Boolean);
  const last = lines.length ? lines[lines.length - 1] : "";
  return last.length > 160 ? last.slice(0, 157) + "…" : last;
}

/* =========================================================================
   Progress UI
   ========================================================================= */
const QUEUED_VISIBLE = 3;

function updateProgressUI(job) {
  const files    = job.files || [];
  const total    = files.length || 1;
  const finished = files.filter((f) => ["done", "failed", "rejected"].includes(f.status)).length;
  const pct      = Math.round((finished / total) * 100);

  progressBar.setAttribute("aria-valuenow", String(pct));
  progressBar.textContent = pct + "%";
  shelfCount.textContent  = `${finished} / ${files.length} · ${pct}%`;

  // Shelf: one segment per record, colored by status (decorative).
  // Big ZIPs get hairline gaps so the shelf never outgrows the page.
  shelfEl.style.gap = files.length > 40 ? "1px" : "";
  shelfEl.innerHTML = files.map((f) => {
    const kind = classify(f);
    const cls = { pass: "pass", warn: "warn", fail: "fail", active: "active" }[kind];
    return `<div class="shelf-seg${cls ? " shelf-seg--" + cls : ""}"></div>`;
  }).join("");

  if (job.current_file) {
    progressLabel.innerHTML = `Now preserving <span>${escHtml(job.current_file)}</span>`;
  } else {
    progressLabel.textContent = finished === 0 ? "Preparing…" : "";
  }

  // Per-record list; queued rows past the first few collapse into one line
  statusList.innerHTML = "";
  let queuedShown = 0;
  const queuedTotal = files.filter((f) => classify(f) === "queued").length;
  files.forEach((f) => {
    const kind = classify(f);
    if (kind === "queued") {
      if (queuedShown >= QUEUED_VISIBLE) return;
      queuedShown++;
    }
    const li = document.createElement("li");
    li.className = "row" + (kind === "active" ? " row--processing" : "") + (kind === "queued" ? " row--queued" : "");
    const name = `<span class="row-name">${escHtml(f.name)}</span>`;
    li.innerHTML = kind === "fail"
      ? `<div class="row-stack">${name}<span class="row-error">${escHtml(plainError(f))}</span></div>${recordBadge(f)}`
      : `${name}${recordBadge(f)}`;
    statusList.appendChild(li);
  });
  const hidden = queuedTotal - queuedShown;
  if (hidden > 0) {
    const li = document.createElement("li");
    li.className = "row row--queued";
    li.innerHTML = `<span class="row-name">… ${hidden} more</span><span class="state-label">QUEUED</span>`;
    statusList.appendChild(li);
  }
}

/* =========================================================================
   Completion UI
   ========================================================================= */
function showCompletion(job) {
  jobCompleted = true;
  hide(progressSection);
  setHero(null);
  show(completeSection);

  if (job.status === "failed") {
    errorSummary.textContent = "Nothing was preserved.";
    showDeadEnd("failed", null, job.files || []);
    return;
  }

  const files = job.files || [];
  const pass  = files.filter((f) => classify(f) === "pass");
  const warn  = files.filter((f) => classify(f) === "warn");
  const fail  = files.filter((f) => classify(f) === "fail");
  const done  = pass.length + warn.length;

  if (warn.length === 0 && fail.length === 0) {
    completeTitle.textContent = done === 1 ? "Record preserved" : `All ${done} records preserved`;
  } else {
    completeTitle.textContent = `${done} of ${files.length} records preserved`;
  }
  errorSummary.textContent = completeTitle.textContent;

  talliesEl.innerHTML = [
    [pass.length, "pass", "Archival grade"],
    [warn.length, "warn", "Check failed"],
    [fail.length, "fail", "Not converted"],
  ].map(([n, cls, label]) =>
    `<div class="tally"><div class="tally-num tally-num--${cls}">${n}</div><span class="label">${label}</span></div>`
  ).join("");

  const fname = job.download_filename || "";
  const ext   = fname.toLowerCase().endsWith(".zip") ? ".zip" : ".pdf";
  let meta    = ext;
  if (job.download_size) meta += " · " + formatBytes(job.download_size);
  if (fail.length > 0)   meta += " · failed records are not included";
  downloadMeta.textContent = meta;

  downloadBtn.href = `${BASE_PATH}/download/${job.job_id}`;
  downloadBtn.classList.remove("disabled");
  downloadBtn.removeAttribute("aria-disabled");

  // Needs attention: failures first, then records that converted but aren't verified archival
  attentionList.innerHTML = "";
  fail.forEach((f) => addAttention(f.name, plainError(f), false));
  warn.forEach((f) => addAttention(
    f.name,
    f.pdfa_validation ? "Included, but did not pass the PDF/A check" : "Included, but was not checked against PDF/A",
    true
  ));
  // Forced files are archival, but the user should know how they were made
  const forced = files.filter((f) => f.status === "done" && f.forced_image);
  forced.forEach((f) => addAttention(
    f.name,
    "Preserved as page images — text was re-read by OCR; links and form fields no longer work",
    true
  ));
  if (fail.length + warn.length + forced.length > 0) show(attentionSection); else hide(attentionSection);

  show(downloadArea);

  if (job.expires_at) {
    const skew = job.server_time ? Date.now() - Date.parse(job.server_time) : 0;
    vaultDeadline = Date.parse(job.expires_at) + skew;
    startCountdown();
  }
}

function addAttention(name, reason, isWarn) {
  const li = document.createElement("li");
  li.className = "row row--small";
  li.innerHTML =
    `<span class="row-name">${escHtml(name)}</span>` +
    `<span class="attention-reason${isWarn ? " attention-reason--warn" : ""}">${escHtml(reason)}</span>`;
  attentionList.appendChild(li);
}

// Check the vault is still open before navigating — a closed vault swaps in the S4 card
downloadBtn.addEventListener("click", async (e) => {
  if (!currentJobId) return;
  e.preventDefault();
  if (downloadBtn.classList.contains("disabled")) return;
  const href = downloadBtn.href;
  try {
    const res = await fetch(`${BASE_PATH}/status/${currentJobId}`, { cache: "no-store" });
    const data = res.ok ? await res.json() : null;
    if (!data || data.vault_closed || !data.download_ready) { showVaultClosed(); return; }
  } catch { /* network blip — let the download itself report */ }
  window.location.href = href;
});

/* =========================================================================
   Dead ends (S4)
   ========================================================================= */
const DEAD_ENDS = {
  failed: {
    icon: `<svg width="72" height="48" viewBox="0 0 60 40" shape-rendering="crispEdges" aria-hidden="true">
             <rect x="12" y="10" width="36" height="26" fill="#ECE6D6" stroke="#8C9A94" stroke-width="2"/>
             <rect x="8" y="4" width="44" height="8" fill="#CFC6AE" stroke="#8C9A94" stroke-width="2"/>
             <rect x="26" y="18" width="8" height="8" fill="#8E3226"/>
           </svg>`,
    title: "Nothing was preserved",
    text: "None of the files could be converted. Check that they open normally and are not password-protected, then try again.",
    button: ["plain-btn plain-btn--xs", "Start over"],
  },
  closed: {
    icon: `<svg width="72" height="48" viewBox="0 0 60 40" shape-rendering="crispEdges" aria-hidden="true">
             <rect x="14" y="4" width="32" height="32" fill="#2E4A45" stroke="#1C2B29" stroke-width="2"/>
             <rect x="24" y="14" width="12" height="12" fill="none" stroke="#B0814A" stroke-width="2"/>
             <rect x="20" y="19" width="20" height="2" fill="#B0814A"/>
           </svg>`,
    title: "The vault is closed",
    text: "These converted files were deleted from the server. Your originals were never changed — convert them again if you still need them.",
    button: ["plain-btn plain-btn--xs", "Preserve another batch"],
  },
  network: {
    icon: `<svg width="72" height="48" viewBox="0 0 60 40" shape-rendering="crispEdges" aria-hidden="true">
             <rect x="6" y="16" width="18" height="10" fill="#5FA898" stroke="#1A2422" stroke-width="2"/>
             <rect x="36" y="16" width="18" height="10" fill="#ECE6D6" stroke="#8C9A94" stroke-width="2"/>
             <rect x="28" y="12" width="2" height="18" fill="#8E3226"/>
           </svg>`,
    title: "Didn't reach the vault",
    text: "The upload stopped before conversion started. Your file list is still here — try again.",
    button: ["press-btn press-btn--xs", "Try again"],
  },
};

function showDeadEnd(kind, detail, files) {
  const d = DEAD_ENDS[kind];

  // For a failed job, say why each file failed instead of only "Nothing was preserved"
  const failedFiles = (files || []).filter((f) => classify(f) === "fail");
  const list = failedFiles.length
    ? `<ul class="dead-end-list">` + failedFiles.map((f) =>
        `<li><span class="row-name">${escHtml(f.name)}</span>` +
        `<span class="attention-reason">${escHtml(plainError(f))}</span></li>`).join("") + `</ul>`
    : "";

  // Files that only failed the archival step can be retried as page images
  const canForce = kind === "failed" && selectedFiles.length > 0 &&
    failedFiles.some((f) => f.exit_code === 10 && !f.forced_image);
  const force = canForce
    ? `<div class="force-explain">${forceExplain.innerHTML}</div>` +
      `<button type="button" class="press-btn press-btn--xs" id="dead-end-force">Try again with Force archival</button>`
    : "";

  deadEnd.classList.toggle("dead-end--wide", failedFiles.length > 0);
  deadEnd.innerHTML =
    `<div class="dead-end-body">${d.icon}` +
    `<div class="dead-end-title">${d.title}</div>` +
    `<div class="dead-end-text">${failedFiles.length ? "None of the files could be converted:" : d.text}</div>` +
    list +
    (detail ? `<div class="dead-end-detail">${escHtml(detail)}</div>` : "") +
    force +
    `<button type="button" class="${d.button[0]}" id="dead-end-btn">${d.button[1]}</button></div>`;
  show(deadEnd);
  show(completeSection);
  document.getElementById("dead-end-btn").addEventListener("click", kind === "network" ? startConversion : resetAll);
  if (canForce) {
    document.getElementById("dead-end-force").addEventListener("click", () => {
      forceImage.checked = true;
      show(forceExplain);
      startConversion();
    });
  }
}

function showVaultClosed() {
  clearInterval(countdownTimer);
  vaultDeadline = null;
  downloadBtn.classList.add("disabled");
  downloadBtn.setAttribute("aria-disabled", "true");
  hide(downloadArea);
  hide(progressSection);
  setHero(null);
  expiryExpired.textContent = "The vault is closed.";
  showDeadEnd("closed");
}

// Upload never started a job: keep selectedFiles and put the list back on screen.
function showFatalError(msg) {
  stopPolling();
  currentJobId = null;
  hide(progressSection);
  hide(downloadArea);
  setHero("idle");
  show(uploadSection);
  resetUploadUI();
  errorSummary.textContent = "Didn't reach the vault.";
  showDeadEnd("network", msg);
}

/* =========================================================================
   Vault countdown
   ========================================================================= */
function startCountdown() {
  clearInterval(countdownTimer);
  tickCountdown();
  countdownTimer = setInterval(tickCountdown, 1000);
}

function tickCountdown() {
  if (!vaultDeadline) return;
  const remaining = vaultDeadline - Date.now();
  if (remaining <= 0) {
    showVaultClosed();
    return;
  }
  const totalSec = Math.floor(remaining / 1000);
  const mins     = Math.floor(totalSec / 60);
  const secs     = totalSec % 60;
  expiryCountdown.textContent = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
  expiryCountdown.classList.toggle("vault-timer--low", remaining < 2 * 60 * 1000);
}

/* =========================================================================
   Preserve another batch
   ========================================================================= */
convertAnotherBtn.addEventListener("click", resetAll);

function resetAll() {
  stopPolling();
  clearInterval(countdownTimer);
  currentJobId  = null;
  vaultDeadline = null;
  jobCompleted  = false;
  selectedFiles = [];
  renderFileList();
  hide(fileWarnings);
  hide(progressSection);
  hide(completeSection);
  hide(downloadArea);
  hide(deadEnd);
  hide(attentionSection);
  errorSummary.textContent  = "";
  expiryExpired.textContent = "";
  expiryCountdown.textContent = "";
  statusList.innerHTML = "";
  shelfEl.innerHTML = "";
  setHero("idle");
  show(uploadSection);
  resetUploadUI();
}

function resetUploadUI() {
  convertBtn.disabled = selectedFiles.length === 0;
}

/* =========================================================================
   Theme (shared family behavior — first paint handled in <head>)
   ========================================================================= */
(function initTheme() {
  const btn  = document.getElementById("themeToggle");
  const root = document.documentElement;
  const sync = () => btn.setAttribute("aria-pressed", String(root.getAttribute("data-theme") === "dark"));
  btn.addEventListener("click", () => {
    const isDark = root.getAttribute("data-theme") === "dark";
    if (isDark) root.removeAttribute("data-theme");
    else root.setAttribute("data-theme", "dark");
    try { localStorage.setItem("leggacy_theme", isDark ? "light" : "dark"); } catch (e) {}
    sync();
  });
  sync();
})();

/* Envelope button: click/tap shows the contact tooltip (hover covers desktop). */
(function () {
  const wrap = document.querySelector(".brand-email-wrap");
  if (!wrap) return;
  const btn = wrap.querySelector(".brand-email-btn");
  let t;
  btn.addEventListener("click", () => {
    wrap.classList.toggle("open");
    clearTimeout(t);
    if (wrap.classList.contains("open")) {
      t = setTimeout(() => wrap.classList.remove("open"), 4000);
    }
  });
  document.addEventListener("click", (e) => {
    if (!wrap.contains(e.target)) wrap.classList.remove("open");
  });
})();

/* =========================================================================
   Utilities
   ========================================================================= */
function escHtml(str) {
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function formatBytes(bytes) {
  if (bytes < 1024)       return bytes + " B";
  if (bytes < 1048576)    return (bytes / 1024).toFixed(1) + " KB";
  return (bytes / 1048576).toFixed(1) + " MB";
}
</script>
</body>
