<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#1C2B29">

<title>PDF LeGGacy · GG IT Toolbox</title>
<%# STAFF GATE deferred: this app is served from ch.ggcity.org, and the toolbox's
    /api/session needs a credentialed-CORS change before a cross-origin probe works. %>
<script>
/* Apply the saved theme before first paint (family key: leggacy_theme). */
(function () {
  var saved = null;
  try { saved = localStorage.getItem('leggacy_theme'); } catch (e) {}
  if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
})();
</script>
<link rel="icon" type="image/svg+xml" href="<%= request.script_name %>/logo.svg">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@400;500;700&family=Press+Start+2P&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= request.script_name %>/style.css">
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<!-- HEADER — family bar -->
