  <div class="header-left">
    <a class="back-btn" href="https://toolbox.ggcity.org/" aria-label="Back to the GG IT Toolbox">
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <rect x="0" y="0" width="6" height="2" fill="currentColor"/>
